    // New 2.4.9 database. null = read from app/etc/env.php of this Magento install.
    'target' => null,

    // Old website code => new website code. Unlisted codes are matched by the same code; when the
    // new shop has a single website, every old website is mapped to it automatically.
    'website_map' => [
        // 'usa' => 'base',
    ],

    // Old store view code => new store view code. Unlisted codes are matched by the same code.
    // Store-level values (names, descriptions, labels...) of unmapped store views are NOT migrated.
    'store_map' => [
        // 'default' => 'default',
        // 'us'      => 'usastoreview',
        // 'global'  => 'globalstoreview',
    ],

    // New store view code used for orders/customers whose old store view is unmapped.
    // null = default store view of the default website.
    'fallback_store' => null,

    // Old customer group code => new customer group code. Unlisted groups are matched by code,
    // missing ones are created.
    'customer_group_map' => [],

    // Old payment method code => new code, for methods of removed extensions, so the admin order
