    // Old MSI source code => new source code. Unlisted sources are created in the target.
    'inventory_source_map' => [],

    // Create product/category/customer attributes that only exist in the old shop.
    'create_missing_attributes' => true,

    // Attribute codes never created in the target (e.g. attributes of removed extensions).
