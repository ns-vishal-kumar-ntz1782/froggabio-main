];
?>
<section id="categories" class="container-site py-8 sm:py-10">
    <div class="mb-6 flex items-end justify-between gap-4">
        <div>
            <p class="text-xs font-extrabold uppercase text-primary"><?= $escaper->escapeHtml(__('Shop by category')) ?></p>
