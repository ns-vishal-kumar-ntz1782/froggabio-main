$arrowButton = 'absolute top-1/2 z-20 grid size-10 -translate-y-1/2 place-items-center rounded-full border'
    . ' border-border-strong bg-card/95 text-foreground shadow-md backdrop-blur-sm transition-colors hover:bg-muted'
    . ' focus-ring';
?>
<script>
    function initHomeHighlights() {
        return {
            scrollByCard() {
                const track = this.$refs.track;
                const card = track.querySelector('article');
                const step = card ? card.offsetWidth + 16 : track.clientWidth;
                track.scrollBy({ left: Number(this.$el.dataset.direction) * step, behavior: 'smooth' });
            }
        }
    }

    window.addEventListener('alpine:init', () => {
        Alpine.data('initHomeHighlights', initHomeHighlights);
    }, { once: true })
</script>
<?php $hyvaCsp->registerInlineScript() ?>

<section id="highlights" class="container-site py-8 sm:py-10">
    <div class="mb-6">
        <p class="text-xs font-extrabold uppercase text-primary"><?= $escaper->escapeHtml(__('Product highlights')) ?></p>
        <h2 class="mt-2 text-3xl font-extrabold sm:text-4xl"><?= $escaper->escapeHtml(__('Featured instruments & solutions')) ?></h2>
    </div>
    <div class="relative" x-data="initHomeHighlights">
        <button type="button" class="<?= $arrowButton ?> left-2" data-direction="-1" @click="scrollByCard"
                aria-label="<?= $escaper->escapeHtmlAttr(__('Previous products')) ?>"
        ><?= $lucideIcons->renderHtml('chevron-left', 'size-4', 16, 16, ['aria-hidden' => 'true']) ?></button>
        <button type="button" class="<?= $arrowButton ?> right-2" data-direction="1" @click="scrollByCard"
                aria-label="<?= $escaper->escapeHtmlAttr(__('Next products')) ?>"
        ><?= $lucideIcons->renderHtml('chevron-right', 'size-4', 16, 16, ['aria-hidden' => 'true']) ?></button>

        <div class="scrollbar-none flex snap-x snap-mandatory gap-4 overflow-x-auto" x-ref="track">
            <?php foreach ($products as $product): ?>
