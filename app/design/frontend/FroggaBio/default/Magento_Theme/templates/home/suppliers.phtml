<?php
/**
 * Homepage supplier brands.
 */

declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var Escaper $escaper */

$searchUrl = fn(string $term): string => $block->getUrl('catalogsearch/result', ['_query' => ['q' => $term]]);

$specialities = ['Stem Cells', 'Cytogenetics', 'Microscopy', 'Exosomes', 'DeNovix', 'Milestone'];
$brands = ['Optika', 'Etaluma', 'Aurox', 'Geneaid', 'Biohelix', 'Scilogex', 'HyLabs', 'GeBa'];
?>
<section id="suppliers" class="border-y border-border bg-surface-soft">
    <div class="container-site py-9 sm:py-10">
        <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
            <div>
                <p class="text-xs font-extrabold uppercase text-primary"><?= $escaper->escapeHtml(__('Our suppliers')) ?></p>
                <h2 class="mt-2 text-2xl font-extrabold sm:text-3xl"><?= $escaper->escapeHtml(__('Trusted brands we distribute')) ?></h2>
            </div>
            <div class="flex flex-wrap gap-2 text-xs font-bold">
                <?php foreach ($specialities as $speciality): ?>
                    <a href="<?= $escaper->escapeUrl($searchUrl($speciality)) ?>"
                       class="rounded-full border border-border bg-card px-3 py-1.5 text-primary transition hover:border-border-strong"
                    ><?= $escaper->escapeHtml(__($speciality)) ?></a>
                <?php endforeach; ?>
            </div>
        </div>
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-8">
            <?php foreach ($brands as $brand): ?>
                <a href="<?= $escaper->escapeUrl($searchUrl($brand)) ?>"
                   class="grid h-20 place-items-center rounded-md border border-border bg-card text-sm font-extrabold uppercase tracking-wide text-muted-foreground transition hover:-translate-y-0.5 hover:border-border-strong hover:text-primary hover:shadow-md"
                ><?= $escaper->escapeHtml($brand) ?></a>
            <?php endforeach; ?>
        </div>
    </div>
</section>
