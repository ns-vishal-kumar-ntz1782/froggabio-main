<script>
    function initHeader() {
        return {
            cart: {},
            isCartOpen: false,
            menu: null,
            mobileOpen: false,
            regionOpen: false,
            region: '<?= $escaper->escapeJs($regions[0]) ?>',
            getData(data) {
                this.cart = data.cart ?? {};
            },
            summaryCount() {
                return this.cart.summary_count || 0;
            },
            cartAriaLabel() {
                return hyva.str('<?= $escaper->escapeJs(__('My cart with %1 items')) ?>', this.summaryCount());
            },
            toggleCart() {
                this.isCartOpen = this.$event.detail?.isOpen ?? true;
                this.$dispatch('toggle-cart', { isOpen: this.isCartOpen })
            },
            menuName() {
                return this.$el.closest('[data-menu]')?.dataset.menu ?? null;
            },
            openMenu() {
                this.menu = this.menuName();
            },
            toggleMenu() {
                const name = this.menuName();
                this.menu = this.menu === name ? null : name;
            },
            closeMenu() {
                this.menu = null;
            },
            isMenuOpen() {
                return this.menu !== null && this.menu === this.menuName();
            },
            toggleMobile() {
                this.mobileOpen = !this.mobileOpen;
            },
            toggleRegion() {
                this.regionOpen = !this.regionOpen;
            },
            closeRegion() {
                this.regionOpen = false;
            },
            selectRegion() {
                this.region = this.$el.dataset.region;
                this.regionOpen = false;
            },
            isSelectedRegion() {
                return this.region === this.$el.dataset.region;
            }
        }
    }

    window.addEventListener('alpine:init', () => {
        Alpine.data('initHeader', initHeader);
    }, { once: true })
</script>
<?php $hyvaCsp->registerInlineScript() ?>

