<?php
/**
 * FroggaBio footer.
 */

declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var Escaper $escaper */

$contactUrl = $block->getUrl('contact');
$searchUrl = fn(string $term): string => $block->getUrl('catalogsearch/result', ['_query' => ['q' => $term]]);

$columns = [
    [__('Company'), [
        [__('About us'), $contactUrl],
        [__('Careers'), $contactUrl],
        [__('Contact us'), $contactUrl],
        [__('Our commitments'), $contactUrl],
    ]],
    [__('Shopping tools'), [
        [__('My account'), $block->getUrl('customer/account')],
        [__('My cart'), $block->getUrl('checkout/cart')],
        [__('Request a quote'), $contactUrl],
        [__('Order FAQ'), $contactUrl],
    ]],
    [__('Speciality products'), [
        [__('Stem Cells'), $searchUrl('Stem Cells')],
        [__('Cytogenetics'), $searchUrl('Cytogenetics')],
        [__('Microscopy'), $searchUrl('Microscopy')],
        [__('Exosomes'), $searchUrl('Exosomes')],
    ]],
];
?>
<div class="bg-primary text-primary-foreground">
    <div class="container-site grid gap-10 py-12 md:grid-cols-[1.2fr_1fr_1fr_1.4fr]">
        <div>
            <img src="<?= $escaper->escapeUrl($block->getViewFileUrl('images/froggabio-logo.png')) ?>"
                 alt="FroggaBio Inc."
                 width="768"
                 height="181"
                 loading="lazy"
                 class="h-auto w-44 brightness-0 invert"
            />
            <p class="mt-4 max-w-xs text-sm leading-6 text-primary-foreground/70">
                <?= $escaper->escapeHtml(__('Life Science, Pathology & Microscopy supplies for researchers across Canada, the USA and globally.')) ?>
            </p>
        </div>
        <?php foreach ($columns as [$title, $links]): ?>
            <div>
                <h3 class="text-sm font-extrabold"><?= $escaper->escapeHtml($title) ?></h3>
                <div class="mt-4 grid gap-3 text-xs text-primary-foreground/70">
                    <?php foreach ($links as [$label, $url]): ?>
                        <a href="<?= $escaper->escapeUrl($url) ?>" class="hover:text-primary-foreground"><?= $escaper->escapeHtml($label) ?></a>
                    <?php endforeach; ?>
                </div>
            </div>
        <?php endforeach; ?>
    </div>
    <div class="border-t border-primary-foreground/15">
        <div class="container-site flex flex-col gap-3 py-5 text-[10px] text-primary-foreground/60 sm:flex-row sm:items-center sm:justify-between">
            <span><?= $escaper->escapeHtml(__('© %1 FroggaBio Inc. All rights reserved.', date('Y'))) ?></span>
            <span><?= $escaper->escapeHtml(__('Canada · USA · Global')) ?></span>
        </div>
