<?php
/**
 * FroggaBio cart items: promotion banner, items table, actions and quick order by catalogue #.
 */

declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\HyvaCsp;
use Hyva\Theme\ViewModel\LucideIcons;
use Hyva\Theme\ViewModel\ProductPage;
use Magento\Checkout\Block\Cart\Grid;
use Magento\Checkout\ViewModel\Cart as CartViewModel;
use Magento\Framework\Escaper;

/** @var Grid $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */
/** @var HyvaCsp $hyvaCsp */

/** @var CartViewModel $cartViewModel */
$cartViewModel = $viewModels->require(CartViewModel::class);

/** @var LucideIcons $lucideIcons */
$lucideIcons = $viewModels->require(LucideIcons::class);

/** @var ProductPage $productViewModel */
$productViewModel = $viewModels->require(ProductPage::class);

$discountTotal = $block->getQuote()->getTotals()['discount'] ?? null;
$discountAmount = $discountTotal ? abs((float) $discountTotal->getValue()) : 0.0;
$discountTitle = $discountTotal ? (string) $discountTotal->getTitle() : '';
if (preg_match('/^Discount \((.+)\)$/', $discountTitle, $matches)) {
    $discountTitle = $matches[1];
}

$outlineButton = 'inline-flex h-11 items-center justify-center rounded-md border border-border-strong px-5 text-sm'
    . ' font-semibold text-foreground transition-colors hover:bg-muted focus-ring';
?>
<script>
    function initQuickOrder() {
        return {
            sku: '',
            qty: 1,
            busy: false,
            submit() {
                const sku = this.sku.trim();
                if (!sku || this.busy) {
                    return;
                }
                this.busy = true;
                const query = '{ products(filter: { sku: { eq: ' + JSON.stringify(sku) + ' } }) { items { id url_key url_suffix __typename } } }';
                fetch(BASE_URL + 'graphql', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ query })
                })
                    .then((response) => response.json())
                    .then((result) => {
                        const product = result.data && result.data.products.items[0];
                        if (!product) {
                            window.dispatchMessages && window.dispatchMessages([{
                                type: 'error',
                                text: hyva.str('<?= $escaper->escapeJs(__('No product found with catalogue # "%1".')) ?>', sku)
                            }], 5000);
                            return;
                        }
                        if (product.__typename !== 'SimpleProduct' && product.__typename !== 'VirtualProduct') {
                            window.location.href = BASE_URL + product.url_key + (product.url_suffix || '');
                            return;
                        }
                        const form = this.$refs.addForm;
                        form.elements.product.value = product.id;
                        form.elements.qty.value = this.qty;
                        hyva.postCart(form);
                        window.dispatchEvent(new CustomEvent('reload-customer-section-data'));
                    })
                    .finally(() => {
                        this.busy = false;
                    });
            }
        }
    }

    function initCartItemQty() {
        return {
            changeQty() {
                const input = this.$refs.qty;
                const step = Number(input.step) || 1;
                const min = Number(input.min) || step;
                const max = Number(input.max) || Infinity;
                const next = Number(input.value) + Number(this.$el.dataset.delta) * step;
                input.value = Math.min(max, Math.max(min, next));
                input.form.requestSubmit();
            },
            submitQty() {
                this.$refs.qty.form.requestSubmit();
            }
        }
    }

    window.addEventListener('alpine:init', () => {
        Alpine.data('initQuickOrder', initQuickOrder);
        Alpine.data('initCartItemQty', initCartItemQty);
    }, { once: true })
</script>
<?php $hyvaCsp->registerInlineScript() ?>

<?php if ($discountAmount > 0): ?>
    <div class="flex items-center gap-3 rounded-lg bg-surface-mint p-4 text-sm">
        <?= $lucideIcons->renderHtml('gift', 'size-5 shrink-0 text-primary', 20, 20, ['aria-hidden' => 'true']) ?>
