                <p class="text-xs text-primary-foreground/75"><?= $escaper->escapeHtml(__('PCI-compliant checkout, curated to be fast and safe.')) ?></p>
            </div>
        </div>
        <div class="rounded-lg border border-border bg-card p-5 text-sm">
            <p class="font-extrabold"><?= $escaper->escapeHtml(__('Need help with your order?')) ?></p>
            <p class="mt-1 text-xs text-muted-foreground"><?= $escaper->escapeHtml(__('Our trained staff are ready to help.')) ?></p>
            <a class="mt-2 inline-block text-xs font-bold text-primary" href="<?= $escaper->escapeUrl($block->getUrl('contact')) ?>">
                <?= $escaper->escapeHtml(__('Contact customer support →')) ?>
