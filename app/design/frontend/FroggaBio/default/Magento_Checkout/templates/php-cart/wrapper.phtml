$itemsCount = $cartBlock ? (int) $cartBlock->getItemsCount() : 0;
?>
<nav aria-label="<?= $escaper->escapeHtmlAttr(__('Breadcrumb')) ?>" class="text-xs font-medium text-muted-foreground">
    <a class="hover:text-primary" href="<?= $escaper->escapeUrl($block->getBaseUrl()) ?>"><?= $escaper->escapeHtml(__('Home')) ?></a>
    <span> / <span class="font-semibold"><?= $escaper->escapeHtml(__('My Cart')) ?></span></span>
</nav>
<h1 class="mt-3 text-4xl font-extrabold">
    <?= $escaper->escapeHtml(__('My Cart')) ?>
    <span class="text-base font-semibold text-muted-foreground">
        <?= $escaper->escapeHtml($itemsCount === 1 ? __('1 item') : __('%1 items', $itemsCount)) ?>
    </span>
</h1>

<div class="mt-6 grid gap-6 lg:grid-cols-[minmax(0,1fr)_22rem]">
    <div class="grid min-w-0 content-start gap-5">
        <?= $block->getChildHtml('form_before') ?>
        <?= $block->getChildHtml('cart-items') ?>
        <?= $block->getChildHtml('checkout_cart_widget') ?>
    </div>

    <aside class="grid h-fit gap-4 lg:sticky lg:top-32">
        <div class="cart-summary-card rounded-lg border border-border bg-card p-5">
