<?php
/**
 * FroggaBio PDP buy box.
 */

declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\Currency;
use Hyva\Theme\ViewModel\LucideIcons;
use Hyva\Theme\ViewModel\ProductPage;
use Magento\Catalog\Model\Product;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */

/** @var ProductPage $productViewModel */
$productViewModel = $viewModels->require(ProductPage::class);

/** @var LucideIcons $lucideIcons */
$lucideIcons = $viewModels->require(LucideIcons::class);

/** @var Currency $currencyViewModel */
$currencyViewModel = $viewModels->require(Currency::class);

/** @var Product $product */
$product = $productViewModel->getProduct();
$productType = $product->getTypeId();

$today = date('Y-m-d');
$newFrom = $product->getNewsFromDate() ? substr((string) $product->getNewsFromDate(), 0, 10) : null;
$newTo = $product->getNewsToDate() ? substr((string) $product->getNewsToDate(), 0, 10) : null;
$isNew = $newFrom && $newFrom <= $today && (!$newTo || $newTo >= $today);

$categoryBadge = null;
foreach ($product->getCategoryCollection()->addAttributeToSelect('name')->addAttributeToFilter('level', ['gt' => 1]) as $category) {
    $categoryBadge = $category->getName();
    break;
}

$metaParts = [__('Cat #: %1', $product->getSku())];
if ($manufacturer = $product->getAttributeText('manufacturer')) {
    $metaParts[] = __('Manufacturer: %1', is_array($manufacturer) ? implode(', ', $manufacturer) : $manufacturer);
}

$contactUrl = $block->getUrl('contact');
$outlineButton = 'inline-flex h-11 items-center justify-center rounded-md border border-border-strong px-5 text-sm'
    . ' font-semibold text-foreground transition-colors hover:bg-muted focus-ring';
?>
<div class="min-w-0">
    <?php if ($isNew || $categoryBadge): ?>
        <div class="flex gap-2">
            <?php if ($isNew): ?>
                <span class="rounded-full bg-highlight px-2.5 py-1 text-[10px] font-extrabold text-highlight-foreground"><?= $escaper->escapeHtml(__('New')) ?></span>
            <?php endif; ?>
            <?php if ($categoryBadge): ?>
                <span class="rounded-full bg-surface-mint px-2.5 py-1 text-[10px] font-extrabold text-primary"><?= $escaper->escapeHtml($categoryBadge) ?></span>
            <?php endif; ?>
        </div>
    <?php endif; ?>

    <h1 class="mt-3 text-3xl font-extrabold leading-tight sm:text-4xl" itemprop="name">
        <?= $escaper->escapeHtml($product->getName()) ?>
    </h1>
    <p class="mt-2 text-xs text-muted-foreground"><?= $escaper->escapeHtml(implode(' · ', array_map('strval', $metaParts))) ?></p>

    <?= $block->getChildHtml('product.info.review') ?>

    <?php if ($shortDescription = $productViewModel->getShortDescription()): ?>
        <div class="mt-4 text-sm leading-6 text-muted-foreground [&_p]:m-0"><?= /* @noEscape */ $shortDescription ?></div>
    <?php endif; ?>

    <div class="pdp-buybox mt-6 rounded-lg border border-border bg-card p-5">
        <div class="flex flex-wrap items-end justify-between gap-3">
            <div class="flex items-baseline gap-2" role="group" aria-label="<?= $escaper->escapeHtmlAttr(__('Price')) ?>">
                <?php if ($productType === 'bundle'): ?>
                    <span class="sr-only"><?= $escaper->escapeHtml(__('The price depends on the chosen options')) ?></span>
                <?php endif; ?>
                <?= $block->getChildHtml('product.info.price') ?>
                <span class="text-xs font-semibold text-muted-foreground"><?= $escaper->escapeHtml($currencyViewModel->getCurrentCurrencyCode()) ?></span>
            </div>
            <div class="flex flex-wrap items-center gap-x-4">
                <?= $block->getChildHtml('product.info.stockstatus') ?>
                <?= $block->getChildHtml('product.info.stockqty') ?>
            </div>
        </div>
        <?= $block->getChildHtml('alert.urls') ?>

        <?php if ($tierPriceBlock = $block->getChildHtml('product.price.tier')): ?>
            <div class="mt-3 text-sm"><?= /** @noEscape */ $tierPriceBlock ?></div>
        <?php endif; ?>

        <div class="mt-4"><?= $block->getChildHtml('product.info.form') ?></div>

        <?php if ($product->isSaleable()): ?>
            <div class="mt-4 grid grid-cols-[auto_1fr] gap-3">
                <?= $block->getChildHtml('product.info.quantity') ?>
                <?= $block->getChildHtml('product.info.addtocart') ?>
            </div>
            <?php if ($block->getChildHtml('addtocart.shortcut.buttons')): ?>
                <div class="mt-3 flex justify-end"><?= $block->getChildHtml('addtocart.shortcut.buttons') ?></div>
            <?php endif; ?>
        <?php endif; ?>

        <div class="mt-3 grid grid-cols-2 gap-3">
            <a href="<?= $escaper->escapeUrl($contactUrl) ?>" class="<?= $outlineButton ?>"><?= $escaper->escapeHtml(__('Add to Quote')) ?></a>
            <a href="<?= $escaper->escapeUrl($contactUrl) ?>" class="<?= $outlineButton ?>"><?= $escaper->escapeHtml(__('Request a Demo')) ?></a>
        </div>

        <div class="mt-4 flex flex-wrap gap-4 text-xs font-bold text-primary">
            <?= $block->getChildHtml('product.info.additional.actions') ?>
            <a href="<?= $escaper->escapeUrl($contactUrl) ?>" class="flex items-center gap-1 hover:underline">
                <?= $lucideIcons->renderHtml('download', 'size-4', 16, 16, ['aria-hidden' => 'true']) ?>
                <?= $escaper->escapeHtml(__('Download brochure')) ?>
            </a>
        </div>

        <?= $block->getChildHtml('product.info.additional') ?>
    </div>

    <div class="mt-4 grid grid-cols-3 gap-3 text-xs">
        <?php foreach ([
            [__('Proudly Canadian'), __('Local distribution')],
            [__('Expert support'), __('You won’t be alone')],
            [__('PCI secure'), __('Safe & fast checkout')],
        ] as [$title, $text]): ?>
            <div class="rounded-md bg-surface-mint p-3">
                <p class="font-extrabold"><?= $escaper->escapeHtml($title) ?></p>
                <p class="text-muted-foreground"><?= $escaper->escapeHtml($text) ?></p>
            </div>
        <?php endforeach; ?>
    </div>
</div>
