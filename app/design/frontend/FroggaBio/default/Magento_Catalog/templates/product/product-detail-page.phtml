<?php
/**
 * FroggaBio PDP: gallery + buy box, tabbed details, related products.
 */

declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\HyvaCsp;
use Hyva\Theme\ViewModel\ProductPage;
use Magento\Catalog\Block\Product\View;
use Magento\Framework\Escaper;

/** @var View $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */
/** @var HyvaCsp $hyvaCsp */

/** @var ProductPage $productViewModel */
$productViewModel = $viewModels->require(ProductPage::class);
$product = $block->getProduct();

$description = (string) $product->getDescription();
$descriptionHtml = $description !== ''
    ? $productViewModel->productAttributeHtml($product, $description, 'description')
    : '';
$overviewImage = $block->getImage($product, 'product_page_image_medium')->getImageUrl();

$specificationsBlock = $block->getLayout()->getBlock('product.attributes');
$specificationsHtml = $specificationsBlock ? trim((string) $specificationsBlock->toHtml()) : '';
$reviewsHtml = trim($block->getChildHtml('review_list') . $block->getChildHtml('review_form'));

$tabs = array_filter([
    'overview' => __('Overview'),
    'specifications' => $specificationsHtml !== '' ? __('Specifications') : null,
    'documents' => __('Documents'),
    'reviews' => $reviewsHtml !== '' ? __('Reviews') : null,
]);
?>
<script>
    function initProductTabs() {
        return {
            tab: 'overview',
            selectTab() {
                this.tab = this.$el.dataset.tab;
            },
            isTab() {
                return this.tab === this.$el.dataset.tab;
            }
        }
    }

    window.addEventListener('alpine:init', () => {
        Alpine.data('initProductTabs', initProductTabs);
    }, { once: true })
</script>
<?php $hyvaCsp->registerInlineScript() ?>

<section class="mt-5 grid items-start gap-8 lg:grid-cols-2"
         aria-label="<?= $escaper->escapeHtmlAttr(__('Product Info')) ?>"
>
    <div class="min-w-0"><?= $block->getChildHtml('product.media') ?></div>
    <?= $block->getChildHtml('product.info') ?>
</section>

<?= $block->getChildHtml('product_options_wrapper_bottom') ?>

<section class="mt-12 rounded-lg border border-border bg-card" x-data="initProductTabs">
    <div class="scrollbar-none flex gap-1 overflow-x-auto border-b border-border px-4" role="tablist">
        <?php foreach ($tabs as $key => $label): ?>
            <button type="button"
                    role="tab"
                    id="tab-<?= $escaper->escapeHtmlAttr($key) ?>"
                    aria-controls="panel-<?= $escaper->escapeHtmlAttr($key) ?>"
                    data-tab="<?= $escaper->escapeHtmlAttr($key) ?>"
                    class="whitespace-nowrap border-b-2 px-4 py-4 text-sm font-bold transition-colors"
                    :class="isTab() ? 'border-primary text-primary' : 'border-transparent text-muted-foreground hover:text-foreground'"
                    :aria-selected="isTab"
                    @click="selectTab"
            ><?= $escaper->escapeHtml($label) ?></button>
        <?php endforeach; ?>
    </div>

    <div id="panel-overview" role="tabpanel" aria-labelledby="tab-overview" data-tab="overview" x-show="isTab"
         class="grid gap-8 p-6 sm:p-8 md:grid-cols-2"
    >
        <div>
            <h2 class="text-2xl font-extrabold"><?= $escaper->escapeHtml(__('Overview')) ?></h2>
            <?php if ($descriptionHtml !== ''): ?>
                <div class="pdp-description mt-3 text-sm leading-6 text-muted-foreground">
                    <?= /* @noEscape */ $descriptionHtml ?>
                </div>
            <?php else: ?>
                <p class="mt-3 text-sm leading-6 text-muted-foreground"><?= $escaper->escapeHtml(__('No description available yet.')) ?></p>
            <?php endif; ?>
        </div>
        <?php if ($overviewImage): ?>
            <img src="<?= $escaper->escapeUrl($overviewImage) ?>"
                 alt="<?= $escaper->escapeHtmlAttr(__('Application')) ?>"
                 width="800"
                 height="600"
                 loading="lazy"
                 class="aspect-[4/3] w-full rounded-md object-cover"
            />
        <?php endif; ?>
    </div>

    <?php if (isset($tabs['specifications'])): ?>
        <div id="panel-specifications" role="tabpanel" aria-labelledby="tab-specifications" data-tab="specifications"
             x-show="isTab" x-cloak class="pdp-specifications p-6 sm:p-8"
        >
            <h2 class="mb-4 text-2xl font-extrabold"><?= $escaper->escapeHtml(__('Specifications')) ?></h2>
            <?= /* @noEscape */ $specificationsHtml ?>
        </div>
    <?php endif; ?>

    <div id="panel-documents" role="tabpanel" aria-labelledby="tab-documents" data-tab="documents"
         x-show="isTab" x-cloak class="p-6 sm:p-8"
    >
        <h2 class="text-2xl font-extrabold"><?= $escaper->escapeHtml(__('Documents')) ?></h2>
        <p class="mt-3 text-sm leading-6 text-muted-foreground">
            <?= $escaper->escapeHtml(__('Brochures, manuals and certificates are available on request.')) ?>
            <a href="<?= $escaper->escapeUrl($block->getUrl('contact')) ?>" class="font-bold text-primary"><?= $escaper->escapeHtml(__('Contact us')) ?></a>
        </p>
    </div>

    <?php if (isset($tabs['reviews'])): ?>
        <div id="panel-reviews" role="tabpanel" aria-labelledby="tab-reviews" data-tab="reviews"
             x-show="isTab" x-cloak class="p-6 sm:p-8"
        >
            <?= /* @noEscape */ $reviewsHtml ?>
        </div>
    <?php endif; ?>
</section>

<?= $block->getChildHtml('related') ?>

<?= $block->getChildHtml('upsell') ?>
