// Cart count: the quote total from checkoutConfig right away, then Luma's customer-data "cart" section.
$cartCountScript = <<<JS
require(['Magento_Customer/js/customer-data'], function (customerData) {
    var counter = document.querySelector('[data-fb-cart-count]');
    var cart = customerData.get('cart');
    var setCount = function (count) {
        counter.textContent = Math.round(Number(count) || 0);
    };
    var quote = window.checkoutConfig && window.checkoutConfig.quoteData;
    if (quote) {
        setCount(quote.items_qty);
    }
    if (cart() && cart().summary_count !== undefined) {
        setCount(cart().summary_count);
    }
    cart.subscribe(function (data) {
        if (data && data.summary_count !== undefined) {
            setCount(data.summary_count);
        }
    });
});
JS;
?>
<?= /* @noEscape */ $secureRenderer->renderTag('script', [], $cartCountScript, false) ?>
